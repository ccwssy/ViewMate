# dsh 产物目录分工（均不进 git）
#   log/      只放 .log
#   report/   散文报告
#   evidence/ 证据块
#   runs/     运行过程原始产物（probes/ 探针脚本, outputs/ 输出, dumps/ xml·截图）
report/*
!report/.gitkeep
evidence/*
!evidence/.gitkeep
runs/*
!runs/.gitkeep
